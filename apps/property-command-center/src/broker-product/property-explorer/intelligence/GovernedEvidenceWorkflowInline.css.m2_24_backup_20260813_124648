.governed-evidence{margin:10px 0;border:1px solid #d5e0e6;border-radius:10px;background:#fff;overflow:hidden;color:#173345;font-size:11px;line-height:1.35}
.governed-evidence__header{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding:11px 12px 7px}
.governed-evidence__heading{display:flex;flex-direction:column;gap:2px;min-width:0}
.governed-evidence__heading>span{font-size:8px;font-weight:800;letter-spacing:.18em;color:#6f8795}
.governed-evidence__heading>strong{font-size:12px;line-height:1.15;color:#173345}
.governed-evidence__header>em{font-style:normal;font-size:8px;font-weight:800;color:#4d7466;white-space:nowrap}
.governed-evidence__intro{margin:0;padding:0 12px 10px;color:#6b7f8b;font-size:9px}
.governed-evidence__rows{border-top:1px solid #e2e9ed}
.governed-evidence__row{display:grid;grid-template-columns:minmax(0,1.2fr) auto minmax(92px,.8fr);align-items:center;gap:10px;padding:10px 12px;border-bottom:1px solid #e8eef1;min-height:48px}
.governed-evidence__identity{display:flex;flex-direction:column;gap:2px;min-width:0}
.governed-evidence__identity strong{font-size:10px;color:#244456;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.governed-evidence__identity span{font-size:8px;color:#7c8e98;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.governed-evidence__status{display:inline-flex;align-items:center;justify-content:center;border-radius:999px;padding:4px 7px;font-size:7px;font-weight:900;letter-spacing:.06em;white-space:nowrap;border:1px solid #d8e1e6;background:#f5f8f9;color:#607681}
.governed-evidence__status--requested{background:#fbf5e9;border-color:#ead9b8;color:#8a6a31}
.governed-evidence__status--evidence_attached{background:#eef5f8;border-color:#cbdde5;color:#315e73}
.governed-evidence__status--verified{background:#edf6f1;border-color:#cce3d6;color:#39735a}
.governed-evidence__status--rejected{background:#faf0ef;border-color:#e7cfcc;color:#8a4e48}
.governed-evidence__controls{display:flex;justify-content:flex-end;min-width:0}
.governed-evidence__button{appearance:none;border:1px solid #173f55;border-radius:6px;background:#173f55;color:#fff;padding:6px 9px;font:inherit;font-size:9px;font-weight:700;line-height:1;cursor:pointer;white-space:nowrap}
.governed-evidence__button:hover{filter:brightness(1.06)}
.governed-evidence__button--secondary{background:#fff;color:#173f55;border-color:#c9d6dc}
.governed-evidence__actions{display:flex;justify-content:flex-end;gap:5px}
.governed-evidence__intake{display:grid;grid-template-columns:1fr 1fr auto;gap:5px;width:100%;grid-column:1/-1}
.governed-evidence__intake input{min-width:0;border:1px solid #d5e0e6;border-radius:6px;padding:6px 7px;font:inherit;font-size:9px;color:#173345;background:#fff}
.governed-evidence__complete{font-size:8px;color:#6f8795;white-space:nowrap}
.governed-evidence__footer{display:flex;justify-content:space-between;gap:10px;padding:7px 12px;background:#f8fafb;color:#7b8e99;font-size:8px}
@media(max-width:430px){.governed-evidence__row{grid-template-columns:minmax(0,1fr) auto}.governed-evidence__controls{grid-column:1/-1;justify-content:flex-start}.governed-evidence__intake{grid-template-columns:1fr}.governed-evidence__footer{flex-direction:column;gap:2px}}
