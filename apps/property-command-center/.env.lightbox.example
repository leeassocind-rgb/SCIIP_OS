# SERVER-SIDE ONLY — do not prefix these with VITE_
LIGHTBOX_API_KEY=
LIGHTBOX_BASE_URL=https://api.lightboxre.com/v1
LIGHTBOX_PROXY_PORT=8787
LIGHTBOX_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
LIGHTBOX_TIMEOUT_MS=8000

# Browser only receives the local/server proxy URL.
# Put this in .env.local when the proxy is running:
# VITE_LIGHTBOX_PROXY_URL=http://127.0.0.1:8787
